# ── Database ──
DATABASE_URL=jdbc:postgresql://localhost:5432/adminos
DB_USER=adminos
# Required (docker compose refuses to start without it): openssl rand -base64 24
DB_PASSWORD=change_me_in_production
DB_MAX_POOL_SIZE=10

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Auth ──
# Required: openssl rand -base64 48 (the whole value is the signing key, AOS-607)
JWT_SECRET=generate_a_256_bit_random_secret_here
JWT_ISSUER=adminos
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL_DAYS=30
# Required with a database: the only Google account allowed to sign in (AOS-614). Anyone else gets "This AdminOS is private".
OWNER_EMAIL=

# Client IPs (rate limits, sign-in lockout, session and audit records; AOS-618). Leave false unless an edge proxy
# in front of the web app APPENDS the real client to X-Forwarded-For (Tailscale serve, Caddy, Cloudflare Tunnel;
# AOS-616): the web proxy forwards a client-sent header unchanged, so trusting it lets anyone choose their IP.
TRUST_FORWARDED_FOR=false
# APP_URL must be the exact origin you open in the browser: the API refuses cookie-authenticated changes
# from any other origin (CSRF check, AOS-618), and Google sign-in returns to APP_URL/auth/callback.

# ── Google OAuth ──
# OAuth client from Google Cloud Console (AOS-111). The client id is also used by the web login page.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_PUBSUB_AUDIENCE=your_pubsub_push_endpoint_or_service_account
# The service account your Pub/Sub push subscription signs as (AOS-609). Gmail push is refused until both are set.
GOOGLE_PUBSUB_SERVICE_ACCOUNT=pubsub-push@your-project.iam.gserviceaccount.com

# ── Google Gmail Pub/Sub ──
# The topic Gmail publishes mailbox changes to (users.watch, renewed every 6 h; AOS-405), e.g.
# projects/<project>/topics/gmail-push. Grant gmail-api-push@system.gserviceaccount.com the
# Pub/Sub Publisher role on it. Empty = push off (the daily fallback sync still runs).
GOOGLE_GMAIL_PUBSUB_TOPIC=
GOOGLE_GMAIL_PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/gmail-push-sub

# ── Security ──
# Required: base64 of exactly 32 random bytes: openssl rand -base64 32 (AOS-608)
TOKEN_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# ── Scheduled jobs (AOS-501) ──
# Bill reminders 09:00, onboarding nudges 11:00, subscription detection 04:00, in SCHEDULER_ZONE.
# Set false on an instance that should only serve requests. Safe with several instances (each slot runs once).
SCHEDULER_ENABLED=true
SCHEDULER_ZONE=Asia/Kolkata
SCHEDULER_TICK_SECONDS=30

# ── Email notifications (AOS-504) ──
# Off unless SMTP_HOST is set. Any SMTP provider works; for Gmail use smtp.gmail.com with an app password
# (Google Account → Security → App passwords). SMTP_SECURITY: starttls (587, default), tls (465) or none (local only, no login).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AdminOS <you@example.com>

# ── Documents vault: Cloudflare R2 (AOS-507) ──
# Off unless DOCS_S3_BUCKET is set. Files are encrypted inside AdminOS before upload (R2 only sees ciphertext).
# Cloudflare dashboard → R2 → Create bucket (keep "Public access" OFF) → Manage R2 API tokens →
# Create token with "Object Read & Write" for THIS bucket only. Endpoint: https://<account id>.r2.cloudflarestorage.com
DOCS_S3_ENDPOINT=
DOCS_S3_REGION=auto
DOCS_S3_BUCKET=
DOCS_S3_ACCESS_KEY_ID=
DOCS_S3_SECRET_ACCESS_KEY=

# ── AI features (API, AOS-702, D-67) ──
# Every model call goes through the API's AI layer: per-feature flags (all off by default), a monthly cost cap
# that fails closed, and an audit row per call with no content. A feature can only be turned on with a provider,
# model and prompt that have a passing eval record (src/main/resources/ai/evals.json); otherwise the API refuses to start.
# Cap on this server's AI spend per UTC month, in US dollars (0 allows only local models).
AI_MONTHLY_CAP_USD=2.00
# Claude (cloud): needed only when a feature uses the anthropic provider. Never commit a real key.
ANTHROPIC_API_KEY=
# Ollama (local): needed only when a feature uses the ollama provider. Start it with
# `docker compose --profile ollama up -d ollama` (docs/guides/local-models.md); inside compose use http://ollama:11434.
OLLAMA_BASE_URL=
# Unload an idle local model after this (compose ollama profile)
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_SECONDS=120

# AI fallback categorizer for "Other" (AOS-512, D-62).
# Only cleaned business names, the payment method and the category list are sent: never amounts, UPI IDs,
# account numbers, message text or who you are. Payments to people are never sent.
AI_CATEGORIZATION_ENABLED=false
# anthropic (default) or ollama
AI_CATEGORIZATION_PROVIDER=anthropic
AI_CATEGORIZATION_MODEL=claude-haiku-5-5

# ── Learned categoriser (API, AOS-707) ──
# Off unless LEARNED_CATEGORIZATION_ENABLED=true. A small model inside the API learns from your own category
# corrections (after 20 corrected payees) and is retrained nightly. It never overrides a rule, and nothing is sent anywhere.
LEARNED_CATEGORIZATION_ENABLED=false

# Weekly briefing in plain words (AOS-716, D-140): a model rewords the briefing's own facts.
# Sent: the briefing's totals, counts, dates, category names and payee/bill names that can't hide personal details.
# Never transactions or messages. Any number or name that isn't one of the facts throws the wording away (the plain
# briefing is shown). Each user also turns it on in Settings → AI features.
AI_BRIEFING_ENABLED=false
# anthropic (default) or ollama; only evaluated models start (src/main/resources/ai/evals.json)
AI_BRIEFING_PROVIDER=anthropic
AI_BRIEFING_MODEL=claude-haiku-5-5

# ── Push notifications (Web Push, AOS-510) ──
# Off unless both keys are set. Generate once with: cd services/api && ./gradlew -q vapidKeys
# (changing them later means every device has to turn push on again). On iPhone: Safari → Share →
# Add to Home Screen, open AdminOS from the Home Screen, then Settings → Turn on notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── App URLs ──
# The browser only talks to APP_URL; the web app proxies /api/* to the API (D-32).
# Private access over Tailscale (docs/guides/PRIVATE-ACCESS.md, AOS-616): https://<host>.<your-tailnet>.ts.net
# The API refuses to start if APP_URL is plain http on anything but localhost/127.0.0.1/::1, or has a path.
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
# Where the web app's proxy reaches the API (local dev: localhost; compose sets api-server).
API_INTERNAL_URL=http://localhost:8080
PORT=8080

# ── Private access (AOS-616, docs/guides/PRIVATE-ACCESS.md) ──
# Only for the Tailscale sidecar overlay (docker-compose.tailnet.yml, servers/VPS): a one-off, tag:adminos
# auth key. Delete it from .env after the first start (the node's identity is then in a volume).
TS_AUTHKEY=
# Only for the optional Gmail push overlay (docker-compose.gmail-push.yml). Off by default: the
# recommended setup has no push and nothing reachable from the internet.
CLOUDFLARED_TUNNEL_ID=
# Absolute path to the tunnel's credentials JSON, outside the repo.
CLOUDFLARED_CREDENTIALS_FILE=

# ── Encrypted backups (AOS-621, docs/guides/BACKUPS.md) ──
# Only for the docker-compose.backup.yml overlay. A SEPARATE R2 bucket (not the documents one), made with
# scripts/backup/setup-r2-bucket.sh; token "Object Read & Write" for that bucket only.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# The age PUBLIC key (age1…) from `age-keygen`. The secret key lives only in your password manager.
BACKUP_AGE_RECIPIENT=
# Daily run time (24 h, in SCHEDULER_ZONE).
BACKUP_AT=02:30
